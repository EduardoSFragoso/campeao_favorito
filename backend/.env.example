# Copie este arquivo para .env (que NUNCA vai pro git) e preencha.
# backend/.env.example

# Neon Postgres (painel do Neon → connection string)
DB_URL=
DB_USER=
DB_PASSWORD=

# Riot Games API (developer.riotgames.com — pessoal/dev, expira em 24h)
RIOT_API_KEY=

# Gere com: openssl rand -base64 64 (mínimo 32 bytes — o JwtService recusa o
# placeholder do application.yml em qualquer perfil exceto dev/test explícito)
JWT_SECRET=

# CORS (origens do front separadas por vírgula)
CORS_ALLOWED_ORIGINS=

# SMTP do e-mail de verificação (EnvironmentFile da VM). Em dev/CI, sem SMTP_HOST o link
# sai apenas no log; no perfil prod o boot RECUSA sem TODOS: SMTP_HOST, SMTP_USER,
# SMTP_PASSWORD e SMTP_FROM preenchidos. Porta padrão 587 com STARTTLS obrigatório.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_AUTH=true (padrão; use false só em relay sem autenticação)

# Descomente na VM de produção (ativa server.address=127.0.0.1 etc.):
# SPRING_PROFILES_ACTIVE=prod
